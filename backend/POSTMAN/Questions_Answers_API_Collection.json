                    "name": "Get All Questions",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/questions?page=1&limit=10&sortBy=createdAt&order=desc&tags=javascript,react",
                            "host": ["{{base_url}}"],
                            "path": ["questions"],
                            "query": [
                                {
                                    "key": "page",
                                    "value": "1",
                                    "description": "Page number for pagination"
                                },
                                {
                                    "key": "limit",
                                    "value": "10",
                                    "description": "Number of questions per page"
                                },
                                {
                                    "key": "sortBy",
                                    "value": "createdAt",
                                    "description": "Sort by: createdAt, votes, answers"
                                },
                                {
                                    "key": "order",
                                    "value": "desc",
                                    "description": "Sort order: asc or desc"
                                },
                                {
                                    "key": "tags",
                                    "value": "javascript,react",
                                    "description": "Filter by tags (comma-separated)"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Search Questions",
                    "request": {
                        "method": "GET",
