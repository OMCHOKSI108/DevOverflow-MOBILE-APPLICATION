                                "key": "Authorization",
                                "value": "Bearer {{jwt_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/admin/reports?status=pending&page=1&limit=50&contentType=question",
                            "host": ["{{base_url}}"],
                            "path": ["admin", "reports"],
                            "query": [
                                {
                                    "key": "status",
                                    "value": "pending",
                                    "description": "Filter by status: pending, resolved, dismissed"
