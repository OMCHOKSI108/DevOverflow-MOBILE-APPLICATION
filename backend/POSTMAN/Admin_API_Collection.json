            "name": "Reports - Public Create, Admin Manage",
            "item": [
                {
                    "name": "Create Report (Protected - Any User)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwt_token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"contentId\": \"question_id_here\",\n  \"contentType\": \"question\",\n  \"reason\": \"This question appears to be spam content with no meaningful programming question\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/admin/reports",
                            "host": ["{{base_url}}"],
                            "path": ["admin", "reports"]
                        }
                    }
                },
                {
                    "name": "Get All Reports (Admin Only)",
                    "request": {
                        "method": "GET",
