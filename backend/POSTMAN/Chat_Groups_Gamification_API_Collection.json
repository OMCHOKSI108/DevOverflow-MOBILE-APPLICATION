                                    "key": "page",
                                    "value": "1"
                                },
                                {
                                    "key": "limit",
                                    "value": "20"
                                },
                                {
                                    "key": "category",
                                    "value": "programming"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Create Group",
                    "request": {
                        "method": "POST",
