                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"React Developers\",\n  \"description\": \"A group for React developers to share knowledge, ask questions, and collaborate on projects\",\n  \"category\": \"programming\",\n  \"isPrivate\": false,\n  \"tags\": [\"react\", \"javascript\", \"frontend\"]\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/groups",
                            "host": ["{{base_url}}"],
                            "path": ["groups"]
                        }
                    }
                },
                {
                    "name": "Get Group Details",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwt_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/groups/:groupId",
                            "host": ["{{base_url}}"],
                            "path": ["groups", ":groupId"],
                            "variable": [
                                {
                                    "key": "groupId",
                                    "value": "group_id_here"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Join Group",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwt_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/groups/:groupId/join",
                            "host": ["{{base_url}}"],
                            "path": ["groups", ":groupId", "join"],
                            "variable": [
                                {
                                    "key": "groupId",
                                    "value": "group_id_here"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Leave Group",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwt_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/groups/:groupId/leave",
                            "host": ["{{base_url}}"],
                            "path": ["groups", ":groupId", "leave"],
                            "variable": [
                                {
                                    "key": "groupId",
                                    "value": "group_id_here"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Post Group Question",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwt_token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"title\": \"Best practices for React Context API\",\n  \"body\": \"I'm working on a large React application and considering using Context API for state management. What are the best practices and potential pitfalls?\",\n  \"tags\": [\"react\", \"context-api\", \"state-management\"]\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/groups/:groupId/questions",
                            "host": ["{{base_url}}"],
                            "path": ["groups", ":groupId", "questions"],
                            "variable": [
                                {
                                    "key": "groupId",
                                    "value": "group_id_here"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Get Group Questions",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwt_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/groups/:groupId/questions?page=1&limit=20&sortBy=createdAt",
                            "host": ["{{base_url}}"],
                            "path": ["groups", ":groupId", "questions"],
                            "query": [
                                {
                                    "key": "page",
                                    "value": "1"
                                },
                                {
                                    "key": "limit",
                                    "value": "20"
                                },
                                {
                                    "key": "sortBy",
                                    "value": "createdAt"
                                }
                            ],
                            "variable": [
                                {
                                    "key": "groupId",
                                    "value": "group_id_here"
                                }
                            ]
                        }
                    }
                }
            ]
        },
