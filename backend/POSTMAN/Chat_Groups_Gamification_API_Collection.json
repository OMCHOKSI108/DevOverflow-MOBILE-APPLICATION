{
    "info": {
        "name": "DevOverflow - Chat & Groups API",
        "_postman_id": "chat-groups-collection-v2",
        "description": "Complete Chat, Groups, and Gamification endpoints for DevOverflow backend",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:3000/api",
            "type": "string"
        },
        {
            "key": "jwt_token",
            "value": "",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Chat - All Protected",
            "item": [
                {
                    "name": "Get Chat Sessions",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwt_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/chat/sessions",
                            "host": ["{{base_url}}"],
                            "path": ["chat", "sessions"]
                        }
                    }
                },
                {
                    "name": "Create Chat Session",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwt_token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"participants\": [\"user_id_1\", \"user_id_2\"],\n  \"type\": \"direct\",\n  \"title\": \"Discussion about React Hooks\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/chat/sessions",
                            "host": ["{{base_url}}"],
                            "path": ["chat", "sessions"]
                        }
                    }
                },
                {
                    "name": "Get Chat Messages",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwt_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/chat/sessions/:sessionId/messages?page=1&limit=50",
                            "host": ["{{base_url}}"],
                            "path": ["chat", "sessions", ":sessionId", "messages"],
                            "query": [
                                {
                                    "key": "page",
                                    "value": "1"
                                },
                                {
                                    "key": "limit",
                                    "value": "50"
                                }
                            ],
                            "variable": [
                                {
                                    "key": "sessionId",
                                    "value": "session_id_here"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Send Chat Message",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwt_token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"message\": \"Hey! I saw your answer about React Hooks. Could you help me understand useEffect dependencies better?\",\n  \"type\": \"text\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/chat/sessions/:sessionId/messages",
                            "host": ["{{base_url}}"],
                            "path": ["chat", "sessions", ":sessionId", "messages"],
                            "variable": [
                                {
                                    "key": "sessionId",
                                    "value": "session_id_here"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Delete Chat Session",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwt_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/chat/sessions/:sessionId",
                            "host": ["{{base_url}}"],
                            "path": ["chat", "sessions", ":sessionId"],
                            "variable": [
                                {
                                    "key": "sessionId",
                                    "value": "session_id_here"
                                }
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Groups - All Protected",
